    "BTTUUID": "C2D81DBC-F6E9-4C94-A688-CB0F8CA29184",
    "BTTPredefinedActionType": 172,
    "BTTPredefinedActionName": "Run Apple Script (blocking)",
    "BTTAdditionalActionData": {
     "BTTScriptType": 0,
     "BTTAppleScriptUsePath": false,
     "BTTScriptLocation": 0,
     "BTTAppleScriptRunInBackground": false,
     "BTTAppleScriptString": "-- Safari vertical tabs: the tab column is \"splitter 2\" of the window's split group; its value is the column width.\n-- Below ~53 px Safari shows the icon-only strip. The last expanded width is kept in ~/.config/safari-tabcol-width.\nset f to (POSIX path of (path to home folder)) & \".config/safari-tabcol-width\"\ntell application \"System Events\" to tell process \"Safari\"\n set s to splitter 2 of splitter group 1 of window 1\n set v to (value of s) as real\n if v > 80 then\n  do shell script \"printf %s \" & (round v) & \" > \" & quoted form of f\n  set value of s to 40\n end if\nend tell"
